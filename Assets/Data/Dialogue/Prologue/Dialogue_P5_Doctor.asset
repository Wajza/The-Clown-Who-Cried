  m_Script: {fileID: 11500000, guid: 9be1a34b3b09200499edfc1e51c2739e, type: 3}
  m_Name: Dialogue_P5_Doctor
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: 18bc10a8a07962546b8e7fb2f251bb55, type: 2}
    text: Ah, Pip! Old Tumbles told me about your... leak. Hop up on the table.
  - speaker: {fileID: 0}
    text: (The doctor peers at the tear through an enormous magnifying glass.)
  - speaker: {fileID: 11400000, guid: 18bc10a8a07962546b8e7fb2f251bb55, type: 2}
    text: Hmm. Salty. Warm. Completely real.
  - speaker: {fileID: 11400000, guid: 1082da33e546bda4997571ad75b67f86, type: 2}
    text: Is it bad? Clowns in Tumbleton don't cry.
  - speaker: {fileID: 11400000, guid: 18bc10a8a07962546b8e7fb2f251bb55, type: 2}
    text: Crying isn't an illness, Pip. It's a feeling finding its way out.
  - speaker: {fileID: 11400000, guid: 18bc10a8a07962546b8e7fb2f251bb55, type: 2}
    text: And when a lot of feelings come out all at once... they can be very powerful.
  - speaker: {fileID: 0}
    text: (Something warm gathers behind Pip's eyes. TEAR BURST learned! When the
      Tear Gauge is full, press Tear Burst.)
  - speaker: {fileID: 11400000, guid: 18bc10a8a07962546b8e7fb2f251bb55, type: 2}
    text: Now go and catch that train. Wonderwick is waiting.
  choices: []
  setFlagWhenFinished: 
