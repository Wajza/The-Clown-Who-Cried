  m_Script: {fileID: 11500000, guid: 9be1a34b3b09200499edfc1e51c2739e, type: 3}
  m_Name: Dialogue_W1_Pun_Ask
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: 830bbacb0fe1c784ea13a74c1bc9c1b5, type: 2}
    text: Ahh! Five boxes of punchlines to deliver and my legs are all jelly!
  - speaker: {fileID: 11400000, guid: 830bbacb0fe1c784ea13a74c1bc9c1b5, type: 2}
    text: Carry each box to a stall before time runs out. No juggling while you carry!
  - speaker: {fileID: 11400000, guid: 830bbacb0fe1c784ea13a74c1bc9c1b5, type: 2}
    text: The jack-in-the-boxes pop up now and then. Hop on their lids to reach the
      high stalls.
  choices: []
